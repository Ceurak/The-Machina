Screen {
    layout: vertical;
}

#top_bar {
    width: 100%;
    height: 3;
}

#range_input {
    width: 1fr;
    margin-right: 1;
}

#discover_button {
    width: 18;
    margin-right: 1;
}

#ports_button {
    width: 16;
    margin-right: 1;
}

#export_button {
    width: 16;
}

#main_content {
    width: 100%;
    height: 1fr;
}

#host_table {
    width: 2fr;
    height: 100%;
    margin-right: 1;
}

#details_view {
    width: 1fr;
    height: 100%;
    border: round white;
    padding: 1;
}
